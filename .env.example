# ================= 统一网关对外鉴权（router）=================
# 客户端调用 /v1/* 时需带  Authorization: Bearer <key>
# 逗号分隔可配多个 key。留空 = 关闭鉴权（不建议，公网必配）。
GATEWAY_API_KEYS=sk-change-me

# ================= 后端地址（compose 内部服务名）=================
# 一般不用改；仅当把后端拆到别处时才改。
QODER_BASE_URL=http://qoder:5050
CODEBUDDY_BASE_URL=http://codebuddy:8787

# ================= 后端各自的 API key（router 转发时使用）=======
QODER_BACKEND_KEY=change-qoder-backend-key
CODEBUDDY_BACKEND_KEY=change-codebuddy-backend-key

# ================= 路由默认与模型映射 =================
DEFAULT_PROVIDER=codebuddy
# Qoder 暴露给 /v1/models 的模型（逗号分隔）
QODER_MODELS=lite
# 额外「裸模型名 -> provider」映射(JSON)，覆盖内置规则；可留空。
# 例：MODEL_ROUTES={"my-model":"qoder"}
MODEL_ROUTES=

# ================= QoderGateway 控制台 =================
QODER_ADMIN_PASSWORD=change-admin-pass
# 首次可选：自动导入 Qoder PAT（留空则在控制台里手动导入）
QODER_PAT=

# ================= codebuddy2api admin 控制台 =================
# ADMIN_KEY 需 >=20 位
CODEBUDDY_ADMIN_KEY=change-me-to-a-long-random-admin-key-0123456789

# ================= 签到 checkin =================
TZ=Asia/Shanghai
# 各家签到时刻（24h，HH:MM）
CHECKIN_TIME_TRAE=08:30
CHECKIN_TIME_QODER=10:05
CHECKIN_TIME_WORKBUDDY=08:35
# 是否启用（Qoder/WorkBuddy 的网关已自动签到，这里默认只开 Trae）
CHECKIN_ENABLE_TRAE=1
CHECKIN_ENABLE_QODER=0
CHECKIN_ENABLE_WORKBUDDY=0
